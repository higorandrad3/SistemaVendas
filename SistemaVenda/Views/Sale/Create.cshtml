@{
    ViewData["Title"] = "Registrar Venda";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark fw-bold"><i class="fas fa-shopping-bag text-primary me-2"></i>Nova Venda</h2>
        <div>
            <button type="button" class="btn btn-outline-danger me-2" onclick="limparCarrinho()">
                <i class="fas fa-trash-alt me-1"></i> Limpar Lista
            </button>
            <button type="button" class="btn btn-success btn-lg shadow-sm" onclick="finalizarVenda()">
                <i class="fas fa-check-circle me-1"></i> Finalizar Venda
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h5 class="card-title mb-4">Adicionar Produto</h5>
                    
                    <div class="mb-3">
                        <label for="produtoPesquisa" class="form-label">Pesquisar Produto (Nome ou Código)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                            <input type="text" id="productSearch" class="form-control border-start-0" placeholder="Ex: Batom Matte, Shampoo Keratina...">
                        </div>
                        <div>
                            <ul id="resultadoBusca" class="list-group position-absolute w-100 shadow-lg" style="z-index: 1000; display: none;">
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="quantidade" class="form-label">Quantidade</label>
                        <input type="number" id="quantity" class="form-control" value="1" min="1" step="1" oninput="validarQuantidade(this)">
                        <div class="form-text text-danger" id="msgErroQtd" style="display:none;">A quantidade deve ser maior que zero.</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary flex-grow-1" id="btnAdd" onclick="addProductInCart()">
                            <i class="fas fa-plus-circle me-1"></i> Adicionar ao Carrinho
                        </button>
                        <button type="button" class="btn btn-light border" id="btnClean">
                            <i class="fas fa-eraser me-1"></i> Limpar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm bg-primary text-white h-100">
                <div class="card-body p-4 d-flex flex-column justify-content-center text-center">
                    <h5 class="opacity-75 mb-2">Total da Venda</h5>
                    <h1 class="display-4 fw-bold mb-3">R$ <span id="totalVenda">0,00</span></h1>
                    <hr class="bg-white opacity-25">
                    <div class="d-flex justify-content-around">
                        <div>
                            <p class="mb-0 opacity-75">Itens</p>
                            <h4 id="totalItens" class="fw-bold">0</h4>
                        </div>
                        <div>
                            <p class="mb-0 opacity-75">Status</p>
                            <h4 class="fw-bold"><span class="badge bg-light text-primary">Aguardando</span></h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold text-secondary">Produtos no Carrinho</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" id="productList">
                        @Html.Partial("_ListPartial")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body { background-color: #f8f9fa; }
    .card { border-radius: 12px; }
    .input-group-text { border-right: none; }
    .form-control:focus { box-shadow: none; border-color: #0d6efd; }
    .table thead th { font-weight: 600; text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.5px; }
    #totalVenda { font-variant-numeric: tabular-nums; }
</style>

@section Scripts {
    <script src="~/js/site.js">
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}