@model ProductViewModel

<div class="container py-4">
    <h3 class="mb-4">Informações do Produto</h3>
    
    <form asp-action="Edit" method="post" class="row g-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label">Nome</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        
        <div class="col-md-3">
            <label asp-for="SKU" class="form-label">SKU</label>
            <input asp-for="SKU" class="form-control" />
            <span asp-validation-for="SKU" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label asp-for="Description" class="form-label">Descrição</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>

        <div class="col-12">
            <div class="form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                <label asp-for="IsActive" class="form-check-label">@(Model.IsActive ? "Produto Ativo" : "Produto Inativo")</label>
            </div>
        </div>

        <div class="col-12 mt-4">
            <button type="submit" class="btn btn-success px-4">Salvar Produto</button>
            <a asp-action="RegisterBatch" asp-route-id="@Model.Id" class="btn btn-warning px-4">Criar lote</a>
            <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        </div>
    </form>
    </br>
    <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
            <tr>
                <th class="ps-4">Lote</th>
                <th class="text-center">Quantidade</th>
                <th class="text-end">Preço Unit.</th>
                <th class="text-end pe-4">Preço Total</th>
                <th class="text-center">Ações</th>
            </tr>
        </thead>
        <tbody id="listaCarrinho">
            @if (Model.Batchs is null)
            {
                <tr id="linhaVazia">
                    <td colspan="5" class="text-center py-5 text-muted">
                        <i class="fas fa-shopping-cart fa-3x mb-3 d-block opacity-25"></i>
                        Nenhum produto adicionado ainda.
                    </td>
                </tr>
            }
            else
            {
                foreach (var batch in Model.Batchs)
                {
                    <tr>
                        <td class="ps-4">@batch.BatchId</td>
                        <td class="text-center">@batch.StockQuantity</td>
                        <td class="text-end">@batch.SalePrice</td>
                        <td class="text-end pe-4">@(batch.SalePrice * batch.StockQuantity)</td>
                        <td class="text-center">
                        <a asp-action="RegisterBatch" asp-route-id="@batch.BatchId">Editar</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>