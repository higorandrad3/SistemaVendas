@model List<Product>

<div class="container py-4">
    <div class="d-flex justify-content-between mb-4">
        <h2>Estoque de Cosméticos</h2>
    </div>

    <table class="table table-hover shadow-sm bg-white rounded">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Preço de Venda</th>
                <th>Estoque</th>
                <th class="text-center">Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (Model is null)
            {
                <tr class="text-center">
                    <td>Não há produtos cadastrados!</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td><strong>@item.Name</strong></td>
                        <td>@item.SalePrice.ToString("C")</td>
                        <td>@item.StockQuantity</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>