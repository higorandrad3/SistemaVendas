@model BatchViewModel

<div class="container py-4">
    <h3 class="mb-4">Criar novo lote</h3>
    
    <form asp-action="RegisterBatch" method="post" class="row g-3">
        <h3>@TempData["ProductName"]</h3>

        <div class="col-md-3">
            <label asp-for="BatchId" class="form-label">Lote</label>
            <input asp-for="BatchId" class="form-control" />
            <span asp-validation-for="BatchId" class="text-danger"></span>
        </div>
        
        <div class="col-md-3">
            <label asp-for="SKU" class="form-label">SKU</label>
            <input asp-for="SKU" class="form-control" />
            <span asp-validation-for="SKU" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="StockQuantity" class="form-label">Quantidade</label>
            <input asp-for="StockQuantity" type="number" class="form-control" />
            <span asp-validation-for="StockQuantity" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="SalePrice" class="form-label">Preço de Venda (R$)</label>
            <input asp-for="SalePrice" class="form-control" />
            <span asp-validation-for="SalePrice" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="PurchasePrice" class="form-label">Preço de Compra (R$)</label>
            <input asp-for="PurchasePrice" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="ManufacturingDate" class="form-label">Data de Fabricação</label>
            <input asp-for="ManufacturingDate" type="date" class="form-control" />
            <span asp-validation-for="ManufacturingDate" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="ExpirationDate" class="form-label">Data de Validade</label>
            <input asp-for="ExpirationDate" type="date" class="form-control" />
            <span asp-validation-for="ExpirationDate" class="text-danger"></span>
        </div>

        <div class="col-12">
            <div class="form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                <label asp-for="IsActive" class="form-check-label">Produto Ativo</label>
            </div>
        </div>

        <div class="col-12 mt-4">
            <button type="submit" class="btn btn-success px-4">Criar lote</button>
            <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        </div>
    </form>
</div>